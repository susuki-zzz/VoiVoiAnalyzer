<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <VoiVoiRoot>$(MSBuildThisFileDirectory)</VoiVoiRoot>
    <VoiVoiCoreInclude>$(VoiVoiRoot)yvc_core\include</VoiVoiCoreInclude>
    <VoiVoiAppInclude>$(VoiVoiRoot)yvc_app\include</VoiVoiAppInclude>
    <KissFFTInclude>$(VoiVoiRoot)third_party\kissfft</KissFFTInclude>
  </PropertyGroup>
  <PropertyGroup>
    <IncludePath>$(VoiVoiCoreInclude);$(VoiVoiAppInclude);$(KissFFTInclude);$(IncludePath)</IncludePath>
    <LibraryPath>$(OutDir);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/permissive- /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level4</WarningLevel>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <FloatingPointModel>Fast</FloatingPointModel>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="VoiVoiRoot">
      <Value>$(VoiVoiRoot)</Value>
    </BuildMacro>
    <BuildMacro Include="VoiVoiCoreInclude">
      <Value>$(VoiVoiCoreInclude)</Value>
    </BuildMacro>
    <BuildMacro Include="VoiVoiAppInclude">
      <Value>$(VoiVoiAppInclude)</Value>
    </BuildMacro>
    <BuildMacro Include="KissFFTInclude">
      <Value>$(KissFFTInclude)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>

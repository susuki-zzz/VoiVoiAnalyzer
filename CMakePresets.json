{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": ["Windows"],
                    "intelliSenseMode": "windows-msvc-x64"
                }
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug (Ninja)",
            "description": "Windows x64 Debug build with Ninja generator",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_YVC_APP": "ON",
                "BUILD_YVC_OFFLINE": "ON",
                "USE_EIGEN": "OFF"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release (Ninja)",
            "description": "Windows x64 Release build with Ninja generator",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_YVC_APP": "ON",
                "BUILD_YVC_OFFLINE": "ON",
                "USE_EIGEN": "OFF"
            }
        },
        {
            "name": "dev-debug",
            "displayName": "Development Debug (Ninja)",
            "description": "Developer debug build with logging enabled",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_YVC_APP": "ON",
                "BUILD_YVC_OFFLINE": "ON",
                "USE_EIGEN": "OFF",
                "YVC_ENABLE_FILE_LOG": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "dev-release",
            "displayName": "Development Release (Ninja)",
            "description": "Developer release build",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BUILD_YVC_APP": "ON",
                "BUILD_YVC_OFFLINE": "ON",
                "USE_EIGEN": "OFF",
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-x64-debug",
            "displayName": "x64 Debug Build",
            "description": "Build Debug configuration",
            "configurePreset": "x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "build-x64-release",
            "displayName": "x64 Release Build",
            "description": "Build Release configuration",
            "configurePreset": "x64-release",
            "configuration": "Release"
        },
        {
            "name": "build-dev-debug",
            "displayName": "Dev Debug Build",
            "description": "Build Dev Debug configuration",
            "configurePreset": "dev-debug",
            "configuration": "Debug"
        },
        {
            "name": "build-dev-release",
            "displayName": "Dev Release Build",
            "description": "Build Dev Release configuration",
            "configurePreset": "dev-release",
            "configuration": "RelWithDebInfo"
        }
    ],
    "testPresets": [
        {
            "name": "core-tests",
            "displayName": "Core Library Tests",
            "description": "Run tests for core analysis library",
            "configurePreset": "x64-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        }
    ]
}
